# ── 필수 ───────────────────────────────────────────
# studio.iux.kr(IUX Cloud)와 같은 Supabase 프로젝트를 씁니다. (IUX ART 표는 iuxart 스키마에 따로 생성)
# Supabase > Connect (또는 Project Settings > Database) > "Transaction pooler" 주소, [YOUR-PASSWORD]에 DB 비밀번호
DATABASE_URL=postgresql://postgres.flrdiplgoeyuvffwxvhq:비밀번호@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# 로그인 쿠키 서명 키 (32자 이상) — 예: openssl rand -hex 32
SESSION_SECRET=
# 주민등록번호·계좌번호 암호화 키 (64자리 hex) — 예: openssl rand -hex 32 · 한 번 정하면 바꾸지 마세요
DATA_KEY=
# 관리자 로그인 계정이자 새 견적·작가 등록·만족도 알림을 받는 주소 (첫 접속 때 계정 자동 생성)
ADMIN_EMAIL=art@iux.kr
ADMIN_PASSWORD=
# 메일·알림톡 속 링크에 쓰는 사이트 주소
SITE_URL=https://art.iux.kr

# ── 메일 (Resend) ─────────────────────────────────
# studio Edge Function Secrets 에 넣어 둔 것과 같은 키를 써도 됩니다. 없으면 발송하지 않고 기록만 남깁니다.
RESEND_API_KEY=
# Resend에서 iux.kr 도메인 인증 후 사용 (인증 전에는 onboarding@resend.dev 로 본인에게만 발송됨)
MAIL_FROM=IUX ART <noreply@iux.kr>

# ── Supabase (사진 저장 · studio 로그인 연결) ─────────
SUPABASE_URL=https://flrdiplgoeyuvffwxvhq.supabase.co
# Project Settings > API Keys > service_role (비밀 키 — Vercel 환경 변수에만 넣고 코드·채팅에 올리지 마세요)
SUPABASE_SERVICE_ROLE_KEY=
# 사진 버킷 (없으면 처음 업로드 때 자동으로 만들어요. studio의 media 버킷과 분리)
SUPABASE_BUCKET=iuxart

# ── 카카오 로그인 (선택) ───────────────────────────
# developers.kakao.com > 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_REST_KEY=
# 카카오 로그인 > 보안 > Client Secret 을 '사용함'으로 했을 때만
KAKAO_CLIENT_SECRET=

# ── 카카오 알림톡 (선택, 솔라피) ─────────────────────
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
# 솔라피에 연동한 카카오 채널의 pfId
SOLAPI_PFID=
# 솔라피에 등록한 발신번호 (- 없이)
SOLAPI_SENDER=
# 심사 통과한 템플릿 ID (알림 종류 이름 그대로)
SOLAPI_TEMPLATES={"공고 알림":"","선정 안내":"","미선정 안내":"","작가 승인":"","정산 정보 요청":"","정산 완료":"","현장 후기 요청":""}

# ── 선택 ───────────────────────────────────────────
# 1 이면 DB가 비어 있을 때 시안 데모 데이터로 시작 (데모 작가 로그인: 각 작가 이메일 / artist1234)
SEED_DEMO=
