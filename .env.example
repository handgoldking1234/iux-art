# ── 필수 ───────────────────────────────────────────
# Supabase > Project Settings > Database > Connection string > "Transaction pooler" (포트 6543)
DATABASE_URL=postgresql://postgres.xxxx:비밀번호@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
# 로그인 쿠키 서명 키 (32자 이상 아무 문자열) — 예: openssl rand -hex 32
SESSION_SECRET=
# 주민등록번호·계좌번호 암호화 키 (64자리 hex) — 예: openssl rand -hex 32 · 한 번 정하면 바꾸지 마세요
DATA_KEY=
# 처음 접속 때 자동으로 만들어지는 관리자 계정
ADMIN_EMAIL=
ADMIN_PASSWORD=
# 메일 속 링크에 쓰는 사이트 주소
SITE_URL=https://art.iux.kr

# ── 메일 (Resend) ─────────────────────────────────
# 없으면 메일은 보내지 않고 mail_outbox 표에 기록만 남깁니다.
RESEND_API_KEY=
# 도메인 인증 전에는 onboarding@resend.dev 로만 (본인 메일로만 발송됨)
MAIL_FROM=IUX ART <noreply@iux.kr>

# ── 사진 저장 (Supabase Storage) ───────────────────
# 없으면 public/uploads 에 저장 (Vercel에서는 사라지므로 운영에는 꼭 설정)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=uploads

# ── 선택 ───────────────────────────────────────────
# 1 이면 DB가 비어 있을 때 시안 데모 데이터로 시작 (데모 작가 로그인: 각 작가 이메일 / artist1234)
SEED_DEMO=
